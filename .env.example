# ALARMv4 Environment Configuration
# Copy to .env and fill in values

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Anthropic API (for expert personas + synthesis)
ANTHROPIC_API_KEY=sk-ant-...

# System 2 Debate Layer
SYSTEM_2_ENABLED=true
SYSTEM_2_REFRESH_INTERVAL_SECONDS=3600

# Moltbook Configuration
MAX_SWARM_SIZE_PER_STAGE=50
MAX_WORKERS=4

# Confidence Thresholds
MIN_GATE_CONFIDENCE=0.95
MIN_ROUTING_CONFIDENCE=0.90

# Storage
FIRESTORE_DATABASE=alarmv4-prod

# Development
DEBUG=false
LOG_LEVEL=INFO
